# Copy to .env and fill in. .env holds only secrets and bootstrap values;
# everything else is a setting in the database, edited in the web admin.

# --- Required --------------------------------------------------------------

# From BotFather. Use a separate test bot while the production bot is
# running: two processes polling with the same token make Telegram reject
# one of them (409 Conflict).
TELEGRAM_BOT_TOKEN=

# Web admin password. Without it the web admin is off.
ADMIN_PASSWORD=

# Your Telegram user ID (ask @userinfobot). Approval DMs go here, and only
# this account can DM the bot or use /enable and /disable.
OWNER_USER_ID=

# --- Model server ----------------------------------------------------------

# API key for the OpenAI-compatible server (local servers usually ignore it).
OPENAI_API_KEY=local

# Read ONCE, on the very first start, to seed the database. After that,
# change the endpoint and model on the web admin's Settings page (Model);
# editing these lines has no effect. In Docker, "localhost" is the container:
# use http://host.docker.internal:8080/v1 for a server on this machine.
OPENAI_BASE_URL=http://localhost:8080/v1
# Leave empty to use the first model the server lists.
OPENAI_MODEL=

# --- Optional --------------------------------------------------------------

# SQLite file. Delete it to start over (the first-start seed runs again).
# DATABASE_PATH=data/naruto.db

# Web admin address. Keep it on 127.0.0.1 outside Docker; the Docker image
# sets 0.0.0.0 and docker-compose.yml publishes it on 127.0.0.1 only.
# WEB_HOST=127.0.0.1
# WEB_PORT=8765
